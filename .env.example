# ==============================================================================
# Batanes Niche Job Portal - Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="Batanes Niche Job Portal"
BASE_URL=http://localhost:8000

# Development-Only Demo Mode (1-click login for employer & job seeker)
DEMO_MODE=true

# ==============================================================================
# Database Configuration (Environment-Switchable)
# ==============================================================================
# DB_PROVIDER: 'sqlite' | 'postgres' (auto-detected if omitted based on DATABASE_URL)
DB_PROVIDER=sqlite

# ------------------------------------------------------------------------------
# OPTION 1: SQLite (Default for Local Development - Zero Setup)
# ------------------------------------------------------------------------------
DATABASE_URL="file:../../Database/batanes_niche.db"

# ------------------------------------------------------------------------------
# OPTION 2: Supabase / PostgreSQL (Production Simulation)
# To switch to Supabase/Postgres, comment Option 1 and uncomment below:
# ------------------------------------------------------------------------------
# DB_PROVIDER=postgres
#
# A) Supabase with Transaction Connection Pooler (Port 6543) - Recommended for App:
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# B) Supabase Direct Connection (Port 5432) - Used for Prisma migrations/schema pushes:
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
#
# C) Local PostgreSQL Container (e.g., via docker-compose up db):
# DATABASE_URL="postgresql://batanes_user:change_me_in_production@localhost:5432/batanes_niche"

# Connection Pooling & Resilience
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT_SEC=30
DB_SSL=false

# ==============================================================================
# Security & Authentication
# ==============================================================================
# JWT Authentication (HS256, 15 min access, 7 days refresh)
JWT_SECRET_KEY=batanes-niche-local-development-secret-key-super-secure-high-entropy-64chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Administrative UI Session Authentication (HttpOnly, Signed Cookie)
ADMIN_SESSION_SECRET=batanes-niche-admin-session-local-secret-super-secure-high-entropy-64chars

# Allowed CORS Origins (JSON array of strings)
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ==============================================================================
# Email Delivery (6-digit Password Reset OTP)
# Local development: credentials blank triggers console simulation
# ==============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@batanesniche.ph
MAIL_FROM_NAME="Batanes Niche Job Portal"
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
