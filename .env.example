# ==============================================================================
# Batanes Niche Job Portal - Environment Configuration Template
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
ENVIRONMENT=development
DEBUG=true
APP_NAME="Batanes Niche Job Portal"
PORT=8000
BASE_URL=http://localhost:8000

# Development-Only Demo Mode (1-click login for employer & job seeker)
# Automatically disabled when ENVIRONMENT=production
DEMO_MODE=true

# ==============================================================================
# Database Configuration (Environment-Switchable)
# ==============================================================================
# DB_PROVIDER: 'sqlite' | 'postgres' (auto-detected if omitted based on DATABASE_URL)
DB_PROVIDER=sqlite

# ------------------------------------------------------------------------------
# OPTION 1: SQLite (Default for Local Development - Zero Setup)
# ------------------------------------------------------------------------------
DATABASE_URL="file:../../Database/batanes_niche.db"

# ------------------------------------------------------------------------------
# OPTION 2: Supabase / PostgreSQL (Production)
# ------------------------------------------------------------------------------
# DB_PROVIDER=postgres
#
# A) Supabase with Transaction Connection Pooler (Port 6543) - App runtime on Render:
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# B) Supabase Direct Connection (Port 5432) - Used for Prisma schema push/migrations:
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Connection Pooling & Resilience
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT_SEC=30
DB_SSL=false

# ==============================================================================
# File Storage (Resumes)
# ==============================================================================
# Optional custom upload path (e.g., '/var/data/uploads' for Render Persistent Disk)
# Defaults to process.cwd()/uploads/resumes
UPLOAD_DIR=

# ==============================================================================
# Security & Authentication (REQUIRED FOR PRODUCTION)
# ==============================================================================
# JWT Authentication (HS256, 15 min access, 7 days refresh)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=batanes-niche-local-development-secret-key-super-secure-high-entropy-64chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Administrative UI Session Authentication (HttpOnly, Signed Cookie)
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=batanes-niche-admin-session-local-secret-super-secure-high-entropy-64chars

# Allowed CORS Origins (JSON array of strings or comma-separated list)
# In production, set to your Vercel deployment URL(s):
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
# Production example:
# ALLOWED_ORIGINS=["https://batanes-niche.vercel.app","https://your-custom-domain.ph"]

# ==============================================================================
# Email Delivery (6-digit Password Reset OTP)
# Local development: leaving credentials blank triggers safe console simulation
# ==============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@batanesniche.ph
MAIL_FROM_NAME="Batanes Niche Job Portal"
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ==============================================================================
# Initial Admin Account Seed (Optional override for production database initialization)
# ==============================================================================
ADMIN_INITIAL_EMAIL=admin@batanesniche.ph
ADMIN_INITIAL_PASSWORD=
