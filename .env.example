# ==============================================================================
# Batanes Niche Job Portal - Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="Batanes Niche Job Portal"
BASE_URL=http://localhost:8000

# Database Configuration
# Local Development / Fast Testing: SQLite
DATABASE_URL=sqlite:///./batanes_niche.db
# Production Deployment: PostgreSQL 15+
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/batanes_niche

# JWT Authentication (HS256, 15 min access, 7 days refresh)
JWT_SECRET_KEY=development-insecure-secret-key-must-be-replaced-in-production-at-least-64-chars-long-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (JSON array of strings)
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# SMTP Email Delivery (Used exclusively for 6-Digit Password Reset OTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@batanesniche.ph
MAIL_FROM_NAME="Batanes Niche Job Portal"
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# Administrative UI Session Authentication (HttpOnly, Secure, SameSite)
ADMIN_SESSION_SECRET=development-insecure-admin-session-secret-key-must-be-replaced-in-production-64-chars
