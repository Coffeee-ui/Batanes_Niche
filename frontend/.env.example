# ==============================================================================
# Batanes Niche Job Portal - Frontend Environment Configuration
# ==============================================================================
# In Vite, variables exposed to the client bundle MUST be prefixed with VITE_

# Backend API Base URL
# - In local development: leave empty to use Vite dev server proxy (defaults to '/api/v1')
# - In Vercel production: set to your deployed Render backend URL (without trailing slash)
#   Example: https://batanes-niche-backend.onrender.com
VITE_API_BASE_URL=
