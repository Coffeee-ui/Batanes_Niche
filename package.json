{
  "name": "batanes-niche-root",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev:backend": "pnpm --filter batanes-niche-backend dev",
    "dev:frontend": "pnpm --filter batanes-niche-frontend dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter batanes-niche-frontend test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:setup": "pnpm --filter batanes-niche-backend db:setup",
    "db:reset": "pnpm --filter batanes-niche-backend db:reset",
    "db:seed": "pnpm --filter batanes-niche-backend db:seed",
    "db:migrate": "pnpm --filter batanes-niche-backend db:migrate",
    "db:push": "pnpm --filter batanes-niche-backend db:push"
  }
}
